      "bytes": 2,
      "decode": "enum",
      "category": "fuel",
      "values": {
        "1": "Open loop: engine cold",
        "2": "Closed loop: oxygen sensor feedback",
        "4": "Open loop: engine load",
        "8": "Open loop: system failure",
        "16": "Closed loop: oxygen sensor feedback, fault in feedback system"
      }
    },
    {
