{
  "schema": 1,
  "id": "generic-obd2",
  "name": "Generic OBD-II",
  "scope": "generic",
  "version": "1.0.0",
  "license": "CC0-1.0",
  "description": "Standard Mode 01, 03, 04, 07, 09 and 0A data for OBD-II compliant vehicles.",
  "sources": [
    "SAE J1979 / ISO 15031-5: diagnostic test modes",
    "SAE J2012 / ISO 15031-6: diagnostic trouble code format",
    "ISO 15765-4: diagnostics on CAN"
  ],
  "pids": [
